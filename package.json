{
  "name": "sony-doja-vie-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:static": "next build",
    "preview:static": "npx http-server out -p 5000",
    "start": "next start",
    "lint": "next lint && npm run lint:style",
    "lint:fix": "next lint --fix && npm run lint:style:fix",
    "lint:style": "stylelint \"**/*.scss\"",
    "lint:style:fix": "stylelint \"**/*.scss\" --fix",
    "depcheck": "npx npm-check --update",
    "lint:all": "npm run lint:fix && npm run format",
    "format": "prettier --write src",
    "check:format": "prettier --check src",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "px2rem": "postcss 'src/**/*.{css,scss}' --config postcss.config.mjs --syntax postcss-scss --no-map --replace",
    "px2rem:file": "postcss --config postcss.config.mjs --syntax postcss-scss --no-map --replace",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^15.3.5",
    "@phantomstudios/css-components": "0.4.0",
    "@pixi/sound": "^6.0.1",
